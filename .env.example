# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored and must never be committed. Every variable below is
# declared and validated in packages/shared/src/config.ts — the application
# refuses to start if any value is missing or malformed.

# development | test | production
NODE_ENV=development

# Port the API server listens on
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info

# --- Local infrastructure (docker-compose.yml) -------------------------------
# Local development values only. Never put real credentials in this file.

POSTGRES_USER=watchdog
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=api_watchdog
# Host port mapping only; containers always talk to postgres:5432
POSTGRES_PORT=5432

# Host port mapping only; containers always talk to redis:6379
REDIS_PORT=6379

# Connection strings as seen FROM INSIDE the Compose network.
# From the host (e.g. running the API outside Docker) use localhost instead.
#
# DATABASE_URL is required: the application and `npm run db:migrate` both
# refuse to start without it. Use the "postgres" host when the process runs
# inside Docker Compose, and "localhost" when it runs on the host.
DATABASE_URL=postgresql://watchdog:change_me_locally@localhost:5432/api_watchdog
#
# REDIS_URL is required by both the API and the worker. Redis is the queue
# transport and the scheduler's clock, never a source of truth: jobs carry only
# a monitor id, and the worker reads the monitor back from PostgreSQL. A lost
# Redis therefore costs pending schedules, which the API rebuilds from the
# database at startup, and never costs data. `rediss://` is accepted for a
# managed provider that requires TLS.
REDIS_URL=redis://localhost:6379

# Maximum PostgreSQL connections this process keeps open (optional, default 10)
DATABASE_POOL_MAX=10

# --- Authentication ----------------------------------------------------------
# HS256 signing key for API access tokens. Minimum 32 characters; the API
# refuses to start without it. Generate a real one per environment with
#   openssl rand -base64 48
# and never reuse this placeholder outside local development.
JWT_SECRET=local_dev_only_change_me_at_least_32_chars
