{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@api-watchdog/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "vitest.config.ts"],
  // apps/web is a browser app: DOM lib, JSX, bundler resolution. It is checked
  // by its own tsconfig instead of being forced into the Node one.
  "exclude": ["apps/web/**"]
}
