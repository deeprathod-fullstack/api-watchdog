# Template for .env.production, read by docker-compose.prod.yml.
#
#     cp .env.production.example .env.production
#
# Then replace EVERY placeholder. .env.production is gitignored and must never
# be committed; on a server it should be readable only by its owner
# (chmod 600 .env.production).
#
# This file lists only what differs per deployment. DATABASE_URL, REDIS_URL,
# NODE_ENV and PORT are not here: docker-compose.prod.yml sets them, pointing
# at the internal `postgres` and `redis` services — never localhost.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=watchdog
# Generate with:  openssl rand -hex 32
# Hex on purpose: the password is embedded in DATABASE_URL, where characters
# such as @ / : # would break the URL.
POSTGRES_PASSWORD=replace_with_output_of_openssl_rand_hex_32
POSTGRES_DB=api_watchdog

# --- Application -------------------------------------------------------------
# HS256 signing key for access tokens, at least 32 characters. The API refuses
# to start without it. Generate with:  openssl rand -base64 48
# Never reuse a development value.
JWT_SECRET=replace_with_output_of_openssl_rand_base64_48

# debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connections per process (the api and the worker each hold a pool).
DATABASE_POOL_MAX=10

# --- Published port ----------------------------------------------------------
# Where the web container is reachable. The only port the stack publishes.
# Local production testing: 127.0.0.1 and 8080 (loopback only).
# EC2: WEB_BIND=0.0.0.0 and WEB_PORT=80.
WEB_BIND=127.0.0.1
WEB_PORT=8080
